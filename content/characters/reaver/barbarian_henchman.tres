{"level": 2, "xp_required": 1000, "stat_adjustments": {"base_attack_bonus": 1, "maximum_hp": 9}, "granted_trait_ids": Array[StringName]([&"feature.uncanny_dodge"]), "summary": "Barbarian Level 2 and Uncanny Dodge."},
