ability_entries = Array[String](["Weapon Focus — Sanctuary Capture Bow: +1 attack with the approved Capture Bow only.", "Patient Overwatch — with the Capture Bow and padded ammunition, the normal Overwatch modifier improves from -2 to -1; final approved Overwatch attack +3. It grants no extra Reaction, shot or trigger."])
