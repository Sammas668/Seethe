feature_parameters = {&"feat.combat_casting": {"concentration_bonus": 4}, &"feat.augmented_healing": {"rank_1_bonus": 2, "rank_2_bonus": 4}, &"feat.spell_focus.compulsion": {"save_dc_bonus": 1}, &"feature.mercy_intercession": {"range_feet": 30, "dice_count": 1, "die_size": 8, "flat_bonus": 3, "uses_per_encounter": 1}}
ability_resource_maximums = {"resource.mercy.cure_light_wounds": 2, "resource.mercy.cure_moderate_wounds": 1, "resource.mercy.command_kneel": 1, "resource.mercy.sanctuary": 1, "resource.mercy.hold_person": 1, "resource.mercy.mercys_rebuke": 1, "resource.mercy.intercession": 1}
ability_entries = Array[String](["Combat Casting — Concentration +10 when casting defensively or while threatened (+6 normal, +4 feat).", "Augmented Healing — approved healing totals are Cure Light 1d8+5 and Cure Moderate 2d8+7.", "Spell Focus — Compulsion — Command: Kneel DC 15 and Hold Person DC 16 only.", "Mercy Intercession — Reaction, once per encounter, 30 feet: reduce incoming lethal damage to any biological living creature by 1d8+3 before HP state.", "Prepared rank 0: Guidance, Resistance, Detect Poison, Light.", "Prepared rank 1: Cure Light Wounds x2, Command: Kneel, Sanctuary.", "Prepared rank 2: Cure Moderate Wounds, Hold Person, Mercy's Rebuke."])
