[gd_resource type="Resource" script_class="CharacterModifierDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://domain/characters/definitions/character_modifier_definition.gd" id="1_modifier"]

[resource]
script = ExtResource("1_modifier")
id = &"effect.rage"
display_name = "Rage"
description = "Quick Action; one use per mission; seven rounds. Strength +4, Constitution +4, Will +2 and Armour Class -2. Constitution raises current and maximum HP by 6. Calm-concentration abilities are unavailable. Fatigued after Rage ends."
ability_modifiers = {"CON": 4, "STR": 4}
stat_modifiers = {"armour_class": -2, "will": 2}
sheet_condition_text = "Rage — active: Strength +4, Constitution +4, Will +2, Armour Class -2; Constitution provides +6 current/maximum HP and +2 Fortitude; melee attack/damage and Grapple gain +2."
