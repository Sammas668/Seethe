[gd_resource type="Resource" script_class="ItemDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://domain/inventory/definitions/item_definition.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"item.mace"
display_name = "Mace"
description = "A compact blunt weapon suitable for lethal or controlled nonlethal strikes."
weight_lb = 8.0
inventory_footprint = Vector2i(2, 2)
handedness = &"one_handed"
