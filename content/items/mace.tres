equipment_tags = Array[StringName]([&"weapon", &"melee", &"mace", &"reaver"])
granted_action_ids = Array[StringName]([&"action.mace_attack"])
tactical_visual_category = &"weapon"

required_proficiency_id = &"proficiency.simple_weapons"
