[gd_resource type="Resource" script_class="ActionDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://domain/actions/action_definition.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"action.mercy.mercy_intercession"
display_name = "Mercy Intercession"
description = "Reaction, once per encounter: reduce incoming lethal damage to a biological living creature within 30 feet by 1d8+3 before HP state is checked."
action_cost_type = &"free"
action_tags = Array[StringName]([&"reaction"])
