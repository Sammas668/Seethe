[gd_resource type="Resource" script_class="ActionDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://domain/actions/action_definition.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"action.guard.subdual_takedown"
display_name = "Subdual Takedown"
description = "After a Sanctuary Blackjack hit, gain +2 on the next Grapple, Trip or Shove against that target before the end of the activation."
action_cost_type = &"half"
action_tags = Array[StringName]([&"feature"])
