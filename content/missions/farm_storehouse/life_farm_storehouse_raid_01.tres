[gd_resource type="Resource" script_class="MissionDefinition" load_steps=26 format=3]

[ext_resource type="Script" path="res://domain/missions/mission_definition.gd" id="1_mission"]
[ext_resource type="Resource" path="res://content/missions/farm_storehouse/life_farm_storehouse_map_01.tres" id="2_map"]
[ext_resource type="Script" path="res://domain/missions/mission_objective_definition.gd" id="3_objective"]
[ext_resource type="Script" path="res://domain/missions/mission_character_placement_definition.gd" id="4_character"]
[ext_resource type="Script" path="res://domain/missions/mission_ground_item_placement_definition.gd" id="5_item"]

[sub_resource type="Resource" id="PrimarySupplies"]
script = ExtResource("3_objective")
objective_id = &"objective.farm.extract_supplies"
display_name = "Steal supplies from the storehouse"
description = "Extract two intact items tagged as mission supplies."
objective_kind = &"extract_items"
qualifying_tags = Array[StringName]([&"mission_supply"])
required_quantity = 2
success_result_code = &"supplies_extracted"
failure_result_code = &"supplies_unobtainable"

[sub_resource type="Resource" id="OptionalCaptive"]
script = ExtResource("3_objective")
objective_id = &"objective.farm.capture_guard"
display_name = "Take a guard captive"
description = "Extract one living restrained settlement guard."
objective_kind = &"extract_captive"
optional = true
qualifying_tags = Array[StringName]([&"settlement_guard", &"capture_eligible"])
required_quantity = 1

[sub_resource type="Resource" id="OptionalFurniture"]
script = ExtResource("3_objective")
objective_id = &"objective.farm.extract_furniture"
display_name = "Steal intact furniture"
description = "Extract one intact furniture item."
objective_kind = &"extract_items"
optional = true
qualifying_tags = Array[StringName]([&"furniture"])
required_quantity = 1
minimum_condition = 0.99

[sub_resource type="Resource" id="OptionalCivilian"]
script = ExtResource("3_objective")
objective_id = &"objective.farm.avoid_civilian_deaths"
display_name = "Avoid killing civilians"
description = "Complete the raid without killing a farmhand."
objective_kind = &"avoid_civilian_deaths"
optional = true
required_quantity = 1

[sub_resource type="Resource" id="OptionalDeadline"]
script = ExtResource("3_objective")
objective_id = &"objective.farm.leave_before_reinforcements"
display_name = "Leave before reinforcements arrive"
description = "Reach extraction with the supplies by the end of round 8."
objective_kind = &"extract_before_round"
optional = true
required_quantity = 1
deadline_round = 8

