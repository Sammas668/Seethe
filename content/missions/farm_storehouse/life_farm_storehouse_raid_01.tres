[resource]
script = ExtResource("1_mission")
mission_definition_id = &"mission_definition.life.farm_storehouse_raid_01"
mission_instance_id = &"mission.life.farm_storehouse_raid_01.debug"
display_name = "Raid the Ilyran Storehouse"
briefing_text = "An isolated Ilyran farm has stored enough grain to provision the warcamp. Enter from the western hedgerow, take what can be carried, and withdraw before the settlement watch gathers reinforcements."
mission_type = &"raid"
map_definition = ExtResource("2_map")
protagonist_character_id = &"character.protagonist.placeholder.0001"
maximum_player_deployment = 3
player_character_ids = Array[StringName]([&"character.protagonist.placeholder.0001", &"character.reaver.marauder.0001", &"character.reaver.marauder.0002"])
character_placements = Array[ExtResource("4_character")]([SubResource("PlayerProtagonist"), SubResource("PlayerMarauderA"), SubResource("PlayerMarauderB"), SubResource("EnemyGuardA"), SubResource("EnemyGuardB"), SubResource("EnemyArcher"), SubResource("EnemyMercy"), SubResource("CivilianA"), SubResource("CivilianB")])
ground_item_placements = Array[ExtResource("5_item")]([SubResource("SupplyCrateA"), SubResource("SupplyCrateB"), SubResource("SupplySackC"), SubResource("FurnitureTable")])
primary_objectives = Array[ExtResource("3_objective")]([SubResource("PrimarySupplies")])
optional_objectives = Array[ExtResource("3_objective")]([SubResource("OptionalCaptive"), SubResource("OptionalFurniture"), SubResource("OptionalCivilian"), SubResource("OptionalDeadline")])
failure_condition_ids = Array[StringName]([&"protagonist_dead", &"player_force_incapacitated", &"primary_objective_impossible"])
loot_profile_id = &"loot_profile.life.farm_storehouse"
notoriety_event_profile_id = &"notoriety_profile.life.farm_raid"
visual_profile_id = &"visual_profile.life.farm_day"
audio_profile_id = &"audio_profile.life.farm_tension"
result_rule_profile_id = &"result_profile.raid.standard"
reinforcement_profile_id = &"reinforcement_profile.life.local_watch_preview"
mission_round_limit = -1
notoriety_preview_lines = Array[String](["Supplies stolen: +3 per qualifying item", "Settlement guard captured: +4", "Civilian killed: +8", "Strategic application is preview-only in Stage 4.7."])
